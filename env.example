# Pick ONE provider: groq (recommended, free tier, fastest) or hf (Hugging Face, free tier)
PROVIDER=groq

# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=

# Get a free token at https://huggingface.co/settings/tokens (needs "Make calls to Inference Providers")
HF_TOKEN=

# Optional
# LANGUAGE=en
# RAW_HOTKEY=ctrl+shift
# CLEAN_HOTKEY=ctrl+alt
# STT_MODEL=whisper-large-v3-turbo
# CLEAN_MODEL=llama-3.3-70b-versatile
